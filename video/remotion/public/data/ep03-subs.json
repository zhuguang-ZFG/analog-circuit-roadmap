[{"from": 54, "to": 186, "text": "输入明明只过了一次门槛，输出为什\n么疯成这样？", "env": [0.0, 0.0273, 0.0341, 0.0455, 0.0545, 0.0705, 0.0864, 0.1023, 0.1295, 0.1659, 0.1795, 0.2091, 0.2523, 0.4545, 0.4727, 0.4932, 0.5091, 0.5182, 0.5523, 0.6136, 0.6636]}, {"from": 197, "to": 467, "text": "因为输入在门槛附近来回穿越：信号\n加噪声，每次过线都翻一次。", "env": [0.0, 0.01, 0.02, 0.0389, 0.0556, 0.1033, 0.1467, 0.1833, 0.2711, 0.2933, 0.3311, 0.3856, 0.4156, 0.4411, 0.5778, 0.5967, 0.6144, 0.6333, 0.6567, 0.7689, 0.8022]}, {"from": 467, "to": 606, "text": "判决边界只有一条，就是这么脆。", "env": [0.0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95, 1.0]}, {"from": 617, "to": 764, "text": "破解思路釜底抽薪：翻转之后，用正\n反馈把门槛挪走。", "env": [0.0, 0.0102, 0.0265, 0.0449, 0.0714, 0.0837, 0.0939, 0.1367, 0.1898, 0.2327, 0.3429, 0.3673, 0.4286, 0.4429, 0.5408, 0.551, 0.5755, 0.5878, 0.6571, 0.6735, 0.998]}, {"from": 764, "to": 923, "text": "升上去用高门槛判，跌回来用低门槛\n判——两条门槛之间，", "env": [0.0, 0.0151, 0.0377, 0.0491, 0.0962, 0.1264, 0.1358, 0.1811, 0.3132, 0.3226, 0.3868, 0.6057, 0.6132, 0.6245, 0.6509, 0.6717, 0.7604, 0.8453, 0.8528, 0.9094, 0.934]}, {"from": 923, "to": 979, "text": "噪声再抖也翻不动。", "env": [0.0, 0.0482, 0.0643, 0.1018, 0.1286, 0.1339, 0.1393, 0.1446, 0.15, 0.1554, 0.1607, 0.1661, 0.1714, 0.1768, 0.2036, 0.2143, 0.2411, 0.2518, 0.2571, 0.2625, 0.3696]}, {"from": 989, "to": 1016, "text": "窗口多宽？", "env": [0.0, 0.0889, 0.1, 0.1, 0.1111, 0.1222, 0.1333, 0.1444, 0.1667, 0.1889, 0.2889, 0.4556, 0.4778, 0.4889, 0.5, 0.5222, 0.6556, 0.6667, 0.6889, 0.7111, 0.7778]}, {"from": 1016, "to": 1097, "text": "R1 比 R2 乘上输出摆幅。", "env": [0.0, 0.1926, 0.2, 0.2074, 0.2185, 0.2259, 0.237, 0.2444, 0.2556, 0.2852, 0.3037, 0.4333, 0.4444, 0.4667, 0.4889, 0.5, 0.5111, 0.6148, 0.7148, 0.7667, 0.9185]}, {"from": 1097, "to": 1216, "text": "R2 比 R1 取 100、摆幅\n 10 伏，", "env": [0.0, 0.1134, 0.1235, 0.1311, 0.1387, 0.1487, 0.1689, 0.179, 0.1866, 0.2244, 0.2975, 0.3101, 0.3555, 0.4261, 0.5798, 0.6605, 0.7109, 0.7311, 0.8496, 0.86