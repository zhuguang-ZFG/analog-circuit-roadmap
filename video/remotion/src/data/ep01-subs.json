[{"from": 54, "to": 178, "text": "你 MOSFET 发烫的原因，可\n能就藏在这个平台上。", "env": [0.0, 0.0121, 0.0194, 0.0339, 0.0435, 0.0532, 0.0605, 0.0702, 0.1089, 0.1185, 0.1645, 0.1887, 0.2105, 0.2516, 0.2806, 0.3024, 0.4403, 0.4669, 0.5056, 0.5347, 0.6653]}, {"from": 189, "to": 380, "text": "开通 MOSFET 要给栅极充电。", "env": [0.0, 0.0126, 0.0361, 0.0974, 0.1068, 0.1162, 0.1932, 0.2497, 0.311, 0.4257, 0.4398, 0.4492, 0.4712, 0.4885, 0.5152, 0.5356, 0.5843, 0.7225, 0.8717, 0.8843, 0.9361]}, {"from": 380, "to": 628, "text": "本来电压一路往上爬——爬着爬着，\n突然不动了。", "env": [0.0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95, 1.0]}, {"from": 639, "to": 765, "text": "这就是米勒平台：漏极电压从母线电\n压掉到零，", "env": [0.0, 0.0095, 0.0167, 0.0333, 0.069, 0.119, 0.1333, 0.3167, 0.3238, 0.331, 0.3381, 0.3833, 0.4, 0.431, 0.5119, 0.6238, 0.8905, 0.8976, 0.919, 0.9595, 0.9952]}, {"from": 765, "to": 922, "text": "这段 dv/dt 把驱动电流全部\n抽走，喂给米勒电容。", "env": [0.0, 0.0592, 0.172, 0.2006, 0.235, 0.3057, 0.3459, 0.4433, 0.4662, 0.5389, 0.7185, 0.7357, 0.7643, 0.7892, 0.8006, 0.8924, 0.9019, 0.9191, 0.9287, 0.9726, 0.9975]}, {"from": 922, "to": 1018, "text": "平台期间，电压和电流同时不为零。", "env": [0.0, 0.0125, 0.0219, 0.0344, 0.0469, 0.1438, 0.1531, 0.1625, 0.1719, 0.1813, 0.1938, 0.2063, 0.2219, 0.2531, 0.2625, 0.2719, 0.2813, 0.2906, 0.3063, 0.3344, 0.4531]}, {"from": 1029, "to": 1148, "text": "P 等于 V 乘 I，乘积曲线下\n面这块面积，", "env": [0.0, 0.0176, 0.0252, 0.0429, 0.1563, 0.1689, 0.2672, 0.2824, 0.4387, 0.4513, 0.5017, 0.5294, 0.5395, 0.5697, 0.5798, 0.595, 0.6605, 0.6958, 0.8496, 0.958, 0.9958]}, {"from": 1148, "to": 1214, "text": "就是这次开通的开关损耗。", "env": [0.0, 0.0136, 0.0318, 0.0455, 0.1091, 0.1273, 0.1318, 0.1409, 0.15, 0.1545, 0.1818, 0.1909, 0.2, 0.2045, 0.2136, 0.2227, 0.2318, 0.2682, 0.3455, 0.3591, 0.4545]}, {"from": 1224, "to": 1350, "text": "频率越高，平台每秒出现的次数越多，\n损耗线性放大。", "env": [0.0, 0.0214, 0.0357, 0.05, 0.0643, 0.0738, 0.1024, 0.1119, 0.1214, 0.1333, 0.2524, 0.2786, 0.2929, 0.3167, 0.3452, 0.4786,