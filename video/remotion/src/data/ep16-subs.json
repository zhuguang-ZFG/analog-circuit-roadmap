[{"from": 144, "to": 217, "text": "两只管子共用一个尾电流源。", "env": [0.0, 0.0082, 0.0164, 0.0288, 0.0411, 0.0822, 0.0945, 0.1274, 0.1397, 0.1521, 0.2466, 0.3699, 0.3822, 0.3945, 0.411, 0.4274, 0.4521, 0.489, 0.5301, 0.6164, 0.711]}, {"from": 217, "to": 368, "text": "共模信号——两边一起变——被尾电\n流源拒收：尾电流恒定，", "env": [0.0, 0.0318, 0.0477, 0.0755, 0.1113, 0.2046, 0.2344, 0.2563, 0.3258, 0.4331, 0.445, 0.4808, 0.5066, 0.5325, 0.6993, 0.7192, 0.751, 0.8364, 0.9556, 0.9695, 0.9974]}, {"from": 368, "to": 435, "text": "谁也多拿不走，输出不动。", "env": [0.0, 0.0269, 0.0448, 0.094, 0.3448, 0.3537, 0.3985, 0.4567, 0.4925, 0.8104, 0.8194, 0.8284, 0.8373, 0.8463, 0.8642, 0.8776, 0.8866, 0.8955, 0.9313, 0.9493, 0.994]}, {"from": 435, "to": 592, "text": "差模信号——一边增一边减——被重\n新分配放大，这就是加薪。", "env": [0.0, 0.0134, 0.0248, 0.1318, 0.149, 0.1586, 0.1815, 0.1968, 0.2236, 0.235, 0.2675, 0.3669, 0.4108, 0.4338, 0.4682, 0.4949, 0.5236, 0.6306, 0.6497, 0.6955, 0.7433]}, {"from": 602, "to": 643, "text": "为什么能拒收？", "env": [0.0, 0.022, 0.0293, 0.0366, 0.0439, 0.0512, 0.0585, 0.0659, 0.0732, 0.0878, 0.139, 0.161, 0.1902, 0.2268, 0.2488, 0.278, 0.3585, 0.4537, 0.4756, 0.4976, 0.5415]}, {"from": 643, "to": 754, "text": "尾电流源是恒流源：两边电流加起来\n恒定，", "env": [0.0, 0.0378, 0.0459, 0.0568, 0.0838, 0.1108, 0.127, 0.1432, 0.2595, 0.4595, 0.4703, 0.4892, 0.5108, 0.5459, 0.5595, 0.5892, 0.6108, 0.7757, 0.9297, 0.9459, 0.9784]}, {"from": 754, "to": 841, "text": "共模怎么抖都分不到额外的电流。", "env": [0.0, 0.0207, 0.0345, 0.0655, 0.0828, 0.1931, 0.2034, 0.2276, 0.2379, 0.2621, 0.2759, 0.2897, 0.3, 0.3345, 0.3517, 0.3655, 0.3759, 0.3862, 0.4138, 0.4552, 0.5448]}, {"from": 851, "to": 877, "text": "差模呢？", "env": [0.0, 0.1269, 0.1385, 0.15, 0.1615, 0.1615, 0.1731, 0.1846, 0.1962, 0.2077, 0.2192, 0.2538, 0.2885, 0.3346, 0.3692, 0.4038, 0.4385, 0.4962, 0.5192, 0.5308, 0.5769]}, {"from": 877, "to": 974, "text": "一边要的多了、另一边要的少了，", "env": [0.0, 0.1268, 0.1392, 0.1608, 0.1763, 0.2351, 0.2536, 0.2691, 0.2969, 0.4546, 0.4732, 0.5041, 0.5412, 0.5722, 0.8784, 0.8907, 0.9031, 0.934, 0.9464, 0.9804, 0.9959]}, {"from": 974, "to": 1096, "text": "尾电流源两头都满足——差额被完整\n放大。", "env": [0.0, 0.0074, 0.0197, 0.0344, 0.0492, 0.1131, 0.1279, 0.1943, 0.2066, 0.2238, 0.4131, 0.4377, 0.4451, 0.4549, 0.4648, 0.482, 0.4943, 0.5164, 0.5459, 0.6148, 0.6762]}, {"from": 1107, "to": 1147, "text": "运放、比较器、", "env": [0.0, 0.015, 0.03, 0.045, 0.105, 0.1275, 0.1425, 0.15, 0.165, 0.1875, 0.4575, 0.51, 0.525, 0.5325, 0.5475, 0.5625, 0.645, 0.675, 0.69, 0.705, 0.7425]}, {"from": 1147, "to": 1311, "text": "带隙基准的第一级全是差分对——同\n一片硅上两只管子天生匹配，", "env": [0.0, 0.0201, 0.0293, 0.0567, 0.139, 0.2634, 0.3201, 0.3677, 0.461, 0.4738, 0.4994, 0.525, 0.5341, 0.5598, 0.5945, 0.7098, 0.7409, 0.8799, 0.9037, 0.9311, 0.9915]}, {"from": 1311, "to": 1374, "text": "这正是比值哲学的起点。", "env": [0.0, 0.019, 0.0286, 0.0667, 0.081, 0.0905, 0.1, 0.1048, 0.1143, 0.1333, 0.1476, 0.1571, 0.181, 0.1905, 0.2238, 0.2429, 0.2619, 0.281, 0.2952, 0.3286, 0.4381]}]